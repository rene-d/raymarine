{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MFDView",
  "version": "0.1.0",
  "identifier": "com.mfdview.instruments",
  "build": {
    "frontendDist": "../webapp/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MFDView",
        "width": 460,
        "height": 900,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": ["icons/icon.png"]
  }
}
